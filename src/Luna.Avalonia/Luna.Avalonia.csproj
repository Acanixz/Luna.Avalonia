<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Luna.Avalonia</PackageId>
    <Description>A Windows XP "Luna" visual theme for Avalonia UI, ported from XP.css.</Description>
    <Authors>Acanixz</Authors>
    <PackageProjectUrl>https://github.com/Acanixz/Luna.Avalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Acanixz/Luna.Avalonia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.2.1</Version>
  </PropertyGroup>

  <!-- Capped below Avalonia 12: Luna's window chrome restyles Avalonia 11's managed TitleBar and
       CaptionButtons, which Avalonia 12 replaced with a new window decorations system, and the
       title bar breaks there. Lift the cap only after porting Styles/Window.axaml,
       Styles/TitleBar.axaml and Styles/CaptionButtons.axaml. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[$(AvaloniaVersion),12.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- MIT (ours and XP.css's) requires the notices to travel with every copy, so the full
       LICENSE (including third-party notices) and the font attribution ship inside the .nupkg. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="Assets\Fonts\*.txt" Pack="true" PackagePath="Assets\Fonts\" />
  </ItemGroup>

</Project>
