<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Controls.Converters"
                    xmlns:sys="using:System"
                    x:ClassModifier="internal">

  <conv:PlatformKeyGestureConverter x:Key="LunaKeyGestureConverter" />

  <!-- No source in XP.css - submenu items follow the same language as top-level ones (blue
       selection). Structure adapted from Avalonia's own Simple theme. -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontFamily" Value="{DynamicResource LunaSansSerifFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource LunaFontSizeNormal}" />
    <Setter Property="Foreground" Value="{DynamicResource LunaWindowTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="{TemplateBinding Background}">
          <Grid ColumnDefinitions="20,5,*,Auto,20">
            <ContentControl Grid.Column="0" Name="PART_ToggleIconPresenter"
                            IsVisible="False" Margin="3" Width="14" Height="14" />
            <ContentControl Grid.Column="0" Name="PART_IconPresenter"
                            Width="14" Height="14" Margin="3"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}" />
            <ContentPresenter Name="PART_HeaderPresenter"
                              Grid.Column="2"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}">
              <ContentPresenter.DataTemplates>
                <DataTemplate DataType="sys:String">
                  <AccessText Text="{Binding}" />
                </DataTemplate>
              </ContentPresenter.DataTemplates>
            </ContentPresenter>
            <TextBlock Name="PART_InputGestureText"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Foreground="{DynamicResource LunaDisabledTextBrush}"
                       Text="{TemplateBinding InputGesture, Converter={StaticResource LunaKeyGestureConverter}}" />
            <Path Name="rightArrow"
                  Grid.Column="4"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  Data="M0,0L4,3.5 0,7z"
                  Fill="{DynamicResource LunaWindowTextBrush}" />
            <Popup Name="PART_Popup"
                   IsLightDismissEnabled="False"
                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                   Placement="RightEdgeAlignedTop">
              <Border Background="{DynamicResource LunaInputSurfaceBrush}" BorderBrush="{DynamicResource LunaInputBorderBrush}" BorderThickness="1">
                <ScrollViewer>
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  Margin="2"
                                  Grid.IsSharedSizeScope="True"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:separator">
      <Setter Property="Template">
        <ControlTemplate>
          <Separator />
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:selected /template/ Border#root">
      <Setter Property="Background" Value="{DynamicResource LunaSelectionBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="^:empty /template/ Path#rightArrow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="^:toggle /template/ ContentControl#PART_ToggleIconPresenter, ^:radio /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:toggle /template/ ContentControl#PART_IconPresenter, ^:radio /template/ ContentControl#PART_IconPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="Content">
        <Template>
          <Path VerticalAlignment="Center"
                Data="M 1,4 L 3,6 L 8,0"
                Stroke="{Binding $parent[MenuItem].Foreground}"
                StrokeThickness="1.4" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="^:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="Content">
        <Template>
          <Ellipse Fill="{Binding $parent[MenuItem].Foreground}" Margin="4" Width="6" Height="6" />
        </Template>
      </Setter>
    </Style>

    <!-- Avalonia's MenuItem closes the whole menu on any click by default (StaysOpenOnClick is
         false); for checkable items the menu should stay open so more than one option can be
         toggled without reopening it each time. -->
    <Style Selector="^:toggle, ^:radio">
      <Setter Property="StaysOpenOnClick" Value="True" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
