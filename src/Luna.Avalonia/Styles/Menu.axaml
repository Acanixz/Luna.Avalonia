<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    x:ClassModifier="internal">

  <!-- No source in XP.css - a top-level menu bar isn't part of that spec. Styled to match the
       established Luna language: the button-face gradient on hover, blue selection on open.
       Structure adapted from Avalonia's own Simple theme. -->
  <ControlTheme x:Key="LunaTopLevelMenuItemTheme" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontFamily" Value="{DynamicResource LunaSansSerifFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource LunaFontSizeNormal}" />
    <Setter Property="Foreground" Value="{DynamicResource LunaWindowTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="{TemplateBinding Background}">
          <Panel>
            <ContentPresenter Name="PART_HeaderPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}">
              <ContentPresenter.DataTemplates>
                <DataTemplate DataType="sys:String">
                  <AccessText Text="{Binding}" />
                </DataTemplate>
              </ContentPresenter.DataTemplates>
            </ContentPresenter>
            <Popup Name="PART_Popup"
                   IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                   Placement="BottomEdgeAlignedLeft"
                   OverlayInputPassThroughElement="{Binding $parent[Menu]}">
              <Border Background="{DynamicResource LunaInputSurfaceBrush}" BorderBrush="{DynamicResource LunaInputBorderBrush}" BorderThickness="1">
                <ScrollViewer>
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  Margin="2"
                                  Grid.IsSharedSizeScope="True"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#root">
      <Setter Property="Background" Value="{DynamicResource LunaButtonFaceGradientBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#root">
      <Setter Property="Background" Value="{DynamicResource LunaSelectionBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource LunaSurfaceBrush}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource LunaTopLevelMenuItemTheme}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
