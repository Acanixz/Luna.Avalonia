<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Simplified, straight-edged vector recreations of the title-bar button glyphs (standard
       Windows minimize/maximize/restore/close iconography, redrawn as flat silhouettes rather
       than the original pixel-art gradient icons - see icon-porting decision). Coordinates are
       in a 9x9 box, stretched to fit inside the caption buttons. -->
  <StreamGeometry x:Key="LunaMinimizeGeometry">M 1,7 L 7,7 L 7,9 L 1,9 Z</StreamGeometry>

  <StreamGeometry x:Key="LunaMaximizeGeometry">M 0,0 L 9,0 L 9,2 L 1,2 L 1,8 L 8,8 L 8,2 L 9,2 L 9,9 L 0,9 Z</StreamGeometry>

  <StreamGeometry x:Key="LunaRestoreGeometry">M 2,0 L 8,0 L 8,2 L 3,2 L 3,3 L 6,3 L 6,5 L 7,5 L 7,2 L 8,2 L 8,6 L 6,6 L 6,9 L 0,9 L 0,5 L 1,5 L 1,8 L 5,8 L 5,5 L 0,5 L 0,3 L 2,3 Z</StreamGeometry>

  <StreamGeometry x:Key="LunaCloseGeometry">M 0,0 L 2,0 L 2,1 L 3,1 L 3,2 L 5,2 L 5,1 L 6,1 L 6,0 L 8,0 L 8,1 L 7,1 L 7,2 L 6,2 L 6,3 L 5,3 L 5,4 L 6,4 L 6,5 L 7,5 L 7,6 L 8,6 L 8,7 L 6,7 L 6,6 L 5,6 L 5,5 L 3,5 L 3,6 L 2,6 L 2,7 L 0,7 L 0,6 L 1,6 L 1,5 L 2,5 L 2,4 L 3,4 L 3,3 L 2,3 L 2,2 L 1,2 L 1,1 L 0,1 Z</StreamGeometry>

</ResourceDictionary>
