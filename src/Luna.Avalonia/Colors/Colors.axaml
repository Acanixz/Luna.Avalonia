<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:luna="clr-namespace:Luna.Avalonia">
  <ResourceDictionary.ThemeDictionaries>
    <!-- "Default" makes the Blue palette resolve even if the consuming app never sets
         Application.RequestedThemeVariant. "Blue" (a custom ThemeVariant, must be keyed via
         x:Static rather than a bare string) is the explicit, forward-compatible key once
         Olive/Silver variants are added alongside it. -->
    <ResourceDictionary x:Key="Default">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Colors/Blue.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static luna:LunaTheme.Blue}">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Colors/Blue.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <!-- Keyed to the built-in ThemeVariant.Dark (bare "Dark" string, same convention Avalonia's
         own Fluent/Simple themes use) rather than a custom variant: this is what lets an app that
         merely follows the OS - RequestedThemeVariant left at ThemeVariant.Default - resolve
         straight to this dictionary the moment the system is in dark mode, with no Luna-specific
         opt-in required. Apps that want Dark regardless of the OS can request it explicitly via
         LunaTheme.Dark (== ThemeVariant.Dark), same pattern as LunaTheme.Blue above. -->
    <ResourceDictionary x:Key="Dark">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Colors/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
